# EspoCRM instance
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=ChangeMeNow123!
ESPOCRM_SITE_URL=http://localhost:8080

# MySQL
MYSQL_ROOT_PASSWORD=espo_root_pw_change_me
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=espo_db_pw_change_me

# Twilio (for SMS on "Ready for Pickup")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
