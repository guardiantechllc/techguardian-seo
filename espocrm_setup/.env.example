# Leave blank to disable SMS — the webhook still fires, it just won't send.

# Google Sheets sync (used by scripts/sheets_sync.py)
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET=
GOOGLE_SHEETS_WORKSHEET=repairs

# EspoCRM API user for sync scripts
ESPO_API_URL=http://localhost:8080/api/v1
ESPO_API_KEY=
