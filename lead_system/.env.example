# ============================================================
# Tech Guardian — Lead Monitor environment variables
# Copy this file to `.env` and fill in the values you want to use.
# Every variable is OPTIONAL — the system degrades gracefully.
# ============================================================

# ---------- Reddit (official API via PRAW) ----------
# Create an app at https://www.reddit.com/prefs/apps  -> "script" type
# If these are blank, the Reddit source will be skipped with a warning.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=techguardian-lead-monitor/0.1 by u/your_reddit_username
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ---------- Google Sheets ----------
# Path to a Google service-account JSON file. If blank OR the file
# doesn't exist, the system writes to CSV only.
GOOGLE_SHEETS_CREDENTIALS_FILE=./credentials/google-sa.json
# Spreadsheet name OR spreadsheet key. Leave blank to disable.
GOOGLE_SHEETS_SPREADSHEET=Tech Guardian Leads
GOOGLE_SHEETS_WORKSHEET=console_hdmi

# ---------- Optional: OpenAI-compatible draft rewriting ----------
# If set, draft_generator can call an LLM to rewrite template drafts
# into sharper variants. If blank, pure template drafts are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Runtime ----------
LOG_LEVEL=INFO
# Comma-separated sources to run. Defaults to every enabled source in
# config/settings.yaml. Example: craigslist,reddit
RUN_SOURCES=
