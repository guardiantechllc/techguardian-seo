      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract response data and lead data\nconst body = $('Response Webhook').item.json.body;\nconst lead = $input.item.json;\n\nreturn {\n  json: {\n    lead_id: body.lead_id,\n    response_type: body.response_type, // 'accepted', 'declined', 'no_response'\n    response_text: body.response_text || '',\n    lead_data: lead\n  }\n};"
      },
      "id": "c1000001-0001-4000-8000-000000000009",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 700]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Handle all response types: accepted, declined, no_response\nconst data = $input.item.json;\nlet newStatus = 'contacted';\n\nif (data.response_type === 'accepted') {\n  newStatus = 'repair_accepted';\n} else if (data.response_type === 'declined') {\n  newStatus = 'repair_declined';\n} else if (data.response_type === 'no_response') {\n  newStatus = 'no_response';\n}\n\nreturn { json: { lead_id: data.lead_id, status: newStatus, response_type: data.response_type } };"
      },
