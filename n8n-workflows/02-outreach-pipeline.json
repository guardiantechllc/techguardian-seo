    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Find the specific lead by lead_id from the webhook body\nconst leadId = $('New Lead Webhook').first().json.body.lead_id;\nconst allRows = $input.all();\nconst match = allRows.find(r => r.json.lead_id === leadId);\nreturn match ? [match] : [{ json: {} }];"
      },
      "id": "c1000001-0001-4000-8000-000000000018",
      "name": "Find Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Generate personalized repair offer message\nconst lead = $input.item.json;\n\nconst deviceType = lead.device_type || 'device';\nconst sellerName = lead.seller_name || '';\nconst firstName = sellerName.split(' ')[0] || 'there';\nconst price = lead.listing_price || 0;\nconst conditionKeywords = lead.condition_keywords || '';\n\n// Determine specific issue from keywords for personalized message\nlet issuePhrase = 'not working';\nif (conditionKeywords.includes('cracked')) issuePhrase = 'has a cracked screen';\nelse if (conditionKeywords.includes('water damage')) issuePhrase = 'has water damage';\nelse if (conditionKeywords.includes('won\\'t turn on')) issuePhrase = 'won\\'t turn on';\nelse if (conditionKeywords.includes('dead')) issuePhrase = 'isn\\'t powering on';\nelse if (conditionKeywords.includes('bricked')) issuePhrase = 'is bricked';\nelse if (conditionKeywords.includes('broken')) issuePhrase = 'is broken';\n\n// Device-specific repair context\nconst repairContext = {\n  'PS5': 'We handle HDMI port repairs, disc drive issues, overheating fixes, and more.',\n  'Xbox Series X': 'We handle HDMI repairs, disc drive fixes, power supply issues, and more.',\n  'Xbox Series S': 'We handle HDMI repairs, power issues, boot problems, and more.',\n  'Nintendo Switch': 'We fix Joy-Con drift, charging port issues, screen replacements, and more.',\n  'MacBook': 'We handle screen replacements, logic board repairs, battery swaps, keyboard fixes, and more.',\n  'Laptop': 'We handle screen replacements, motherboard repairs, battery swaps, and more.',\n  'Other': 'We fix a wide range of electronics issues.'\n};\n\nconst repairLine = repairContext[deviceType] || repairContext['Other'];\n\n// Craft the repair offer message\nconst message = `Hey ${firstName}! I saw your listing for the ${deviceType} that ${issuePhrase}. I run a repair shop here in Lee's Summit and there's a good chance I can fix it so you can keep using it instead of selling it for parts.\n\n${repairLine}\n\nWould you be interested in getting a free diagnostic to see what it would cost to repair? No pressure at all - just want to help if I can!`;\n\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    device_type: deviceType,\n    seller_name: sellerName,\n    listing_price: price,\n    outreach_type: 'repair_offer',\n    message_draft: message,\n    lead_data: lead\n  }\n};"
      },
