# Kids Book Generator - Environment Configuration
# 100% Open Source - No API costs!

# ===========================================
# OLLAMA CONFIGURATION (Story Generation)
# ===========================================
# Ollama API URL (default: local installation)
OLLAMA_URL=http://localhost:11434

# Model to use for story generation
# Recommended models: llama3.2, mistral, llama2
OLLAMA_MODEL=llama3.2

# ===========================================
# STABLE DIFFUSION CONFIGURATION (Images)
# ===========================================
# Stable Diffusion API URL
# For Automatic1111: http://localhost:7860
# For ComfyUI: http://localhost:8188
SD_URL=http://localhost:7860

# API type: 'automatic1111' or 'comfyui'
SD_API_TYPE=automatic1111

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
